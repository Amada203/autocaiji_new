{
  "data_path": "data/processed/time_series_data.csv",
  "output_dir": "experiments/runs/fusion_model_experiment",
  "model_params": {
    "prophet": {
      "yearly_seasonality": true,
      "weekly_seasonality": true,
      "daily_seasonality": false,
      "seasonality_mode": "multiplicative",
      "changepoint_prior_scale": 0.05
    },
    "lgbm": {
      "objective": "regression",
      "metric": "rmse",
      "boosting_type": "gbdt",
      "num_leaves": 31,
      "learning_rate": 0.05,
      "feature_fraction": 0.9,
      "n_estimators": 100
    }
  },
  "experiment": {
    "test_size": 0.2,
    "random_state": 42,
    "normalize_data": true,
    "normalize_method": "z-score",
    "forecast_periods": 30,
    "comparison": {
      "run_prophet_only": true,
      "run_lgbm_only": true,
      "run_fusion": true
    }
  },
  "visualization": {
    "save_plots": true,
    "plot_prophet_components": true,
    "plot_residuals": true,
    "plot_feature_importance": true,
    "plot_predictions": true
  }
}