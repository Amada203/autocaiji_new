{
  "data_path": "data/processed/time_series_data.csv",
  "output_dir": "experiments/runs/sampling_experiment",
  "model_params": {
    "prophet": {
      "yearly_seasonality": true,
      "weekly_seasonality": true,
      "daily_seasonality": false,
      "seasonality_mode": "multiplicative",
      "changepoint_prior_scale": 0.05
    },
    "lgbm": {
      "objective": "binary",
      "metric": "auc",
      "boosting_type": "gbdt",
      "num_leaves": 31,
      "learning_rate": 0.05,
      "feature_fraction": 0.9,
      "n_estimators": 100
    }
  },
  "experiment": {
    "test_size": 0.2,
    "random_state": 42,
    "normalize_data": true,
    "normalize_method": "z-score",
    "change_threshold": 0.01,
    "required_columns": [
      "ds",
      "y"
    ]
  },
  "clustering": {
    "method": "hierarchical",
    "n_clusters": null,
    "max_clusters": 10
  },
  "scheduling": {
    "capture_rate_target": 0.95,
    "max_samples_per_day": 50,
    "forecast_days": 30,
    "use_clustering": true,
    "use_sentinel": true
  },
  "visualization": {
    "save_plots": true,
    "plot_probability_distribution": true,
    "plot_sampling_schedule": true,
    "plot_sku_clusters": true
  }
}